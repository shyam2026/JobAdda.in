generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  password         String
  name             String?
  role             Role            @default(STUDENT)
  referralCode     String          @unique
  referredBy       String?
  walletBalance    Float           @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  phone            String?
  isPremium        Boolean         @default(false)
  premiumUntil     DateTime?
  premiumResumeDownloads Int @default(0)
  applications     Application[]
  conversations    Conversation[]  @relation("StudentConversations")
  certificates     Certificate[]
  educations       Education[]
  experiences      Experience[]
  receivedMessages Message[]       @relation("ReceivedMessages")
  sentMessages     Message[]       @relation("SentMessages")
  notifications    Notification[]
  projects         Project[]
  purchases        Purchase[]
  resumeConfig     ResumeConfig?
  skills           Skill[]
  studentProfile   StudentProfile?
  transactions     Transaction[]
}

model ResumeConfig {
  id               String   @id @default(cuid())
  userId           String   @unique
  showBio          Boolean  @default(true)
  showPhone        Boolean  @default(true)
  showEmail        Boolean  @default(true)
  showSkills       Boolean  @default(true)
  showEdu          Boolean  @default(true)
  showExp          Boolean  @default(true)
  showProjects     Boolean  @default(true)
  showSocials      Boolean  @default(true)
  selectedTemplate String   @default("T1")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String    @db.Text
  type      String
  link      String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?   @db.Text
  link        String?
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Project_userId_fkey")
}

model StudentProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  bio          String?  @db.Text
  phone        String?
  location     String?
  github       String?
  linkedin     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  website      String?
  profileImage String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Education {
  id          String    @id @default(cuid())
  userId      String
  school      String
  degree      String
  field       String?
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean   @default(false)
  grade       String?
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Education_userId_fkey")
}

model Experience {
  id          String    @id @default(cuid())
  userId      String
  company     String
  role        String
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean   @default(false)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Experience_userId_fkey")
}

model Skill {
  id        String   @id @default(cuid())
  userId    String
  name      String
  level     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Certificate {
  id        String    @id @default(cuid())
  userId    String
  name      String
  issuer    String
  issueDate DateTime?
  url       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Certificate_userId_fkey")
}

model Job {
  id                String        @id @default(cuid())
  companyId         String
  title             String
  description       String        @db.Text
  location          String
  salary            String?
  requirements      String?       @db.Text
  type              JobType       @default(INTERNAL)
  externalLink      String?
  status            String        @default("OPEN")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  category          String        @default("Other")
  employmentType    String?       @default("Full-time")
  openings          Int?          @default(1)
  education         String?
  experience        String?
  skills            String?       @db.Text
  createdByAdminId  String?
  applications      Application[]
  conversations     Conversation[]
  company           CompanyUser   @relation("CompanyUserJobs", fields: [companyId], references: [id])

  @@index([companyId], map: "Job_companyId_fkey")
}

model Application {
  id        String            @id @default(cuid())
  jobId     String
  studentId String
  status    ApplicationStatus @default(PENDING)
  resumeUrl String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  job       Job               @relation(fields: [jobId], references: [id])
  student   User              @relation(fields: [studentId], references: [id])

  @@index([jobId], map: "Application_jobId_fkey")
  @@index([studentId], map: "Application_studentId_fkey")
}

model ResumeTemplate {
  id           String     @id @default(cuid())
  name         String
  price        Float
  previewImage String?
  purchases    Purchase[]
}

model Purchase {
  id         String         @id @default(cuid())
  userId     String
  templateId String
  amount     Float
  status     String         @default("COMPLETED")
  createdAt  DateTime       @default(now())
  couponCode String?
  orderId    String?
  paymentId  String?
  refId      String?
  template   ResumeTemplate @relation(fields: [templateId], references: [id])
  user       User           @relation(fields: [userId], references: [id])

  @@index([templateId], map: "Purchase_templateId_fkey")
  @@index([userId], map: "Purchase_userId_fkey")
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  type       String
  discount   Int?
  usageLimit Int       @default(100)
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  target     String    @default("ALL") // "ALL", "RESUME", "PREMIUM"
  createdAt  DateTime  @default(now())
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String   @db.Text
  timestamp  DateTime @default(now())
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])

  @@index([receiverId], map: "Message_receiverId_fkey")
  @@index([senderId], map: "Message_senderId_fkey")
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  amount        Float
  type          String
  status        String   @default("PENDING")
  couponCode    String?
  paymentId     String?
  orderId       String?
  createdAt     DateTime @default(now())
  triggeredById String?
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "Transaction_userId_fkey")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  contact   String
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model ScholarshipEntry {
  id              String   @id @default(cuid())
  registrationNo  String   @unique
  name            String
  mobile          String
  email           String
  district        String
  state           String
  lastQualification String
  marksPercent    String
  careerGoal      String
  fatherName      String?
  aadharNo        String?
  mobileVerified  Boolean  @default(false)
  emailVerified   Boolean  @default(false)
  paymentStatus   String   @default("PENDING")
  paymentId       String?
  orderId         String?
  amount          Float?
  couponCode      String?
  passportImage   String?  @db.LongText
  campaign        String   @default("INDEPENDENCE") // "INDEPENDENCE" or "DIWALI"
  examScore           Float?
  examSubmitted       Boolean  @default(false)
  examAttempted       Int?
  examCorrect         Int?
  examWrong           Int?
  examNegativeMarks   Float?
  examMathScore       Float?
  examReasoningScore  Float?
  examCaScore         Float?
  examAnswers         String?  @db.LongText
  proctorViolations   Int      @default(0)
  proctorSnapshots    String?  @db.LongText  // JSON array of base64 snapshots metadata
  proctorLog          String?  @db.LongText  // JSON array of { type, timestamp, details }
  cashCollectedBy     String?              // Name of admin/subadmin who collected cash
  cashCollectedById   String?              // ID of admin/subadmin who collected cash
  emailSent       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([mobile])
  @@index([email])
  @@index([campaign])
  @@index([mobile, campaign])
}

model ScholarshipOtp {
  id        String   @id @default(cuid())
  target    String
  type      String
  otp       String
  sendCount Int      @default(1)
  lastSentAt DateTime @default(now())
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([target, type])
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("SUBADMIN")
  modules   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
}

model CompanyUser {
  id               String   @id
  slug             String?  @unique
  email            String?  @unique
  password         String?
  name             String?
  companyName      String
  contactNo        String?
  role             String   @default("ADMIN")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bio              String?  @db.Text
  founded          String?
  hq               String?
  logo             String?
  moreDetails      String?  @db.LongText
  size             String?
  type             String?
  industry         String?
  website          String?
  createdByAdminId String?
  isActive         Boolean  @default(true)
  jobs             Job[]    @relation("CompanyUserJobs")
  conversations    Conversation[] @relation("CompanyConversations")
}

model Conversation {
  id          String        @id @default(cuid())
  studentId   String
  companyId   String
  jobId       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  student     User          @relation("StudentConversations", fields: [studentId], references: [id], onDelete: Cascade)
  company     CompanyUser   @relation("CompanyConversations", fields: [companyId], references: [id], onDelete: Cascade)
  job         Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  messages    ChatMessage[]

  @@unique([studentId, companyId, jobId])
  @@index([studentId])
  @@index([companyId])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  senderType     String       // "STUDENT" or "COMPANY"
  content        String       @db.Text
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

enum Role {
  STUDENT
  COMPANY
  ADMIN
  SUBADMIN
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEW
  HIRED
  REJECTED
}

enum JobType {
  INTERNAL
  EXTERNAL
}
