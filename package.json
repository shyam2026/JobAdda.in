{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"const fs=require('fs'); fs.rmSync('public/_next',{recursive:true,force:true});\"",
    "build": "prisma generate && next build",
    "postbuild": "node -e \"const fs=require('fs'); const p=require('path'); fs.rmSync('public/_next',{recursive:true,force:true}); if(fs.existsSync('.next/static')){fs.mkdirSync('public/_next/static',{recursive:true}); fs.cpSync('.next/static','public/_next/static',{recursive:true}); console.log('Copied .next/static -> public/_next/static');} else {console.log('No .next/static found, skipping copy');}\"",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tiptap/extension-bullet-list": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-list-item": "^3.22.5",
    "@tiptap/extension-ordered-list": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.9",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "prisma": "^6.19.3",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "typescript": "^6.0.3"
  }
}
